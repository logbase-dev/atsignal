rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 이미지 파일은 모든 사용자가 읽을 수 있음 (public)
    // 쓰기는 인증된 사용자만 가능 (Functions를 통해서만)
    match /images/{allPaths=**} {
      allow read: if true;  // 모든 사용자가 이미지 읽기 가능
      allow write: if request.auth != null;  // 인증된 사용자만 쓰기 가능 (Functions)
    }
    
    // blog_author 경로 명시적 허용 (이미 위의 images/{allPaths=**}에 포함되지만 명시적으로 추가)
    match /images/blog_author/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 다른 경로는 기본적으로 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}